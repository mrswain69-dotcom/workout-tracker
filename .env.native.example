# Isolated backend only. Copy to .env.native.local. Never use service-role keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Requires an explicit release decision; leave unset for beta testing.
# NATIVE_ALLOW_PRODUCTION=1

# Enable only after versioned_log_saves migration is applied to the test project.
VITE_LOG_SYNC_MODE=versioned

# Debug/staging application ID and auth callback. Review separately for release.
VITE_NATIVE_BUILD_TARGET=staging
